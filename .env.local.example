# ─────────────────────────────────────────────────────────────
# Row1Merch — Environment Variables
# Copy this file to .env.local for local development.
# Add each variable to your Vercel project under
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase project URL
# Found at: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose in the browser
# Found at: Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SECRET, never expose publicly
# Used server-side only (API routes) to bypass Row Level Security
# Found at: Supabase Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
